[Unit]
Description=xne: mirror GitHub se7enxweb/exponential (branches, tags) to the GitLab release mirror
Documentation=file:///opt/xne/doc/server.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
Environment=XNE_MIRROR_TO=git@gitlab.com:your-group/exponential.git
ExecStart=/usr/local/bin/xne server:mirror
